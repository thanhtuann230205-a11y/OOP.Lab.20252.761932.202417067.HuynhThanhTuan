<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1024" prefHeight="768">
    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="Options">
                        <items>
                            <MenuItem text="View store" onAction="#viewStorePressed" />
                        </items>
                    </Menu>
                    <Menu text="Update Store">
                        <items>
                            <MenuItem text="Add Book" />
                            <MenuItem text="Add CD" />
                            <MenuItem text="Add DVD" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            <Label text="CART" textFill="AQUA">
                <font>
                    <Font size="50" />
                </font>
                <padding>
                    <Insets top="10" right="0" bottom="10" left="10" />
                </padding>
            </Label>
        </VBox>
    </top>
    <center>
        <VBox>
            <padding>
                <Insets top="0" right="0" bottom="0" left="10" />
            </padding>
            <fx:define>
                <ToggleGroup fx:id="filterCategory" />
            </fx:define>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets top="10" right="0" bottom="10" left="0" />
                </padding>
                <Label text="Filter:" />
                <TextField fx:id="tfFilter" />
                <RadioButton fx:id="radioBtnFilterId" text="By ID" selected="true" toggleGroup="$filterCategory" />
                <RadioButton fx:id="radioBtnFilterTitle" text="By Title" toggleGroup="$filterCategory" />
            </HBox>
            <TableView fx:id="tblMedia">
                <columns>
                    <TableColumn fx:id="colMediaTitle" text="Title" />
                    <TableColumn fx:id="colMediaCategory" text="Category" />
                    <TableColumn fx:id="colMediaCost" text="Cost" />
                </columns>
            </TableView>
            <ButtonBar>
                <buttons>
                    <Button fx:id="btnPlay" text="Play" onAction="#playButtonPressed" />
                    <Button fx:id="btnRemove" text="Remove" onAction="#removeButtonPressed" />
                </buttons>
            </ButtonBar>
        </VBox>
    </center>
    <right>
        <VBox alignment="TOP_CENTER" spacing="20">
            <padding>
                <Insets top="50" right="10" bottom="0" left="20" />
            </padding>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Total:">
                    <font>
                        <Font size="24" />
                    </font>
                </Label>
                <Label fx:id="lblTotalCost" text="0 $" textFill="AQUA">
                    <font>
                        <Font size="24" />
                    </font>
                </Label>
            </HBox>
            <Button text="Place Order" textFill="WHITE" style="-fx-background-color: red;" onAction="#placeOrderPressed">
                <font>
                    <Font size="24" />
                </font>
            </Button>
        </VBox>
    </right>
</BorderPane>
